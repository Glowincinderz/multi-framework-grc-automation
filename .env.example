# ══════════════════════════════════════════════════════════════════════════════
# ISO 27001:2022 GRC Automation Framework — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Drata Integration ─────────────────────────────────────────────────────────
# API key from: Drata workspace → Settings → API Keys
DRATA_API_KEY=your_drata_api_key_here

# Drata deployment region: "us" (default) or "eu"
# US endpoint: https://public-api.us.drata.com/api
# EU endpoint: https://public-api.eu.drata.com/api
DRATA_REGION=us

# ── Jira Integration ──────────────────────────────────────────────────────────
# Base URL of your Atlassian Cloud instance
JIRA_BASE_URL=https://yourcompany.atlassian.net

# Atlassian account email
JIRA_EMAIL=you@yourcompany.com

# API token from: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token_here

# Jira project key for GRC tickets (e.g. GRC, SEC, ISMS)
JIRA_PROJECT_KEY=GRC

# ── GRC Database ──────────────────────────────────────────────────────────────
# Optional: override default SQLite database path
# GRC_DB_PATH=/path/to/grc_database.db

# Optional: directory for automated database backups
# GRC_BACKUP_DIR=/path/to/backups

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL (default: INFO)
GRC_LOG_LEVEL=INFO

# Optional: log output file (leave blank to log to stdout only)
# GRC_LOG_FILE=/var/log/grc_automation.log

# ── AI-drafted risk memos (optional) ───────────────────────────────────────────
# Used by: python vendor_risk.py assess <vendor-file> --ai
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GRC_AI_MODEL=claude-sonnet-5-5
