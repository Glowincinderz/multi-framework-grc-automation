%% ============================================================
%% ISO 27001:2022 GRC AUTOMATION — PROCESS DIAGRAMS
%% Integrated with Drata GRC Platform
%% ============================================================


%% ────────────────────────────────────────────────────────────
%% DIAGRAM 1: END-TO-END GRC PROCESS OVERVIEW
%% ────────────────────────────────────────────────────────────

flowchart TD
    subgraph INIT["🚀 1. INITIALISATION"]
        A([Start]) --> B[Init SQLite Database]
        B --> C[Load 93 ISO 27001:2022\nAnnex A Controls]
        C --> D[Seed Artifact\nRequirements Checklist]
    end

    subgraph DRATA["🔄 2. DRATA SYNC"]
        E[Connect to Drata API] --> F{API Key\nConfigured?}
        F -->|Yes - Live| G[Pull Control\nStatuses]
        F -->|No - Offline| H[Simulate Drata\nSync / Mock]
        G --> I[Pull Monitor\nResults]
        I --> J[Pull Evidence\nArtifacts]
        H --> K[Update Local DB\nwith Drata Data]
        J --> K
    end

    subgraph RISK["⚠ 3. RISK MANAGEMENT"]
        L[Identify Assets\n& Threats] --> M[Score Likelihood\n& Impact 1-5]
        M --> N[Calculate\nInherent Risk]
        N --> O{Risk\nLevel?}
        O -->|Critical ≥15| P[Immediate\nTreatment Required]
        O -->|High 10-14| Q[Mitigate /\nTransfer]
        O -->|Medium 6-9| R[Accept with\nControls]
        O -->|Low <6| S[Accept /\nMonitor]
        P & Q & R & S --> T[Record Residual\nRisk Score]
        T --> U[Link to\nAnnex A Controls]
    end

    subgraph TESTING["🧪 4. CONTROL TESTING"]
        V[Select Control\nfor Testing] --> W{Test\nType?}
        W -->|Design| X[Review Policy &\nProcedure Docs]
        W -->|Operating\nEffectiveness| Y[Test Implementation\nvia Evidence]
        X & Y --> Z{Result?}
        Z -->|Pass| AA[Mark Control\nImplemented]
        Z -->|Partial| AB[Log Finding &\nRemediation Plan]
        Z -->|Fail| AC[Create NC &\nCAR]
        AB & AC --> AD[Schedule\nRe-test]
    end

    subgraph AUDIT["📋 5. AUDIT MANAGEMENT"]
        AE[Plan Audit\nSchedule] --> AF[Define Scope\n& Criteria]
        AF --> AG[Execute Audit\nFieldwork]
        AG --> AH[Raise Findings\nNC / OFI / Obs]
        AH --> AI[Root Cause\nAnalysis]
        AI --> AJ[Assign CAR\nOwner & Due Date]
        AJ --> AK{Finding\nClosed?}
        AK -->|No| AL[Track &\nEscalate]
        AK -->|Yes| AM[Record Closure\nEvidence]
        AL --> AJ
    end

    subgraph ARTIFACT["📁 6. ARTIFACT COLLECTION"]
        AN[Generate Artifact\nChecklist per Control] --> AO{Already in\nDrata?}
        AO -->|Yes - Auto| AP[Mark as Collected\nvia Drata Sync]
        AO -->|No - Manual| AQ[Request Evidence\nfrom Team]
        AQ --> AR[Upload & Register\nArtifact in DB]
        AP & AR --> AS[Track Expiry\nDates]
        AS --> AT{Expiring\nSoon?}
        AT -->|Yes| AU[Alert Owner\nto Renew]
        AT -->|No| AV[Artifact Valid]
    end

    subgraph REPORT["📊 7. REPORTING"]
        AW[Gather All\nGRC Data] --> AX[Generate Excel\nWorkbook]
        AX --> AY[Dashboard\nKPIs]
        AX --> AZ[Control Register\nSheet]
        AX --> BA[Risk Register\nSheet]
        AX --> BB[Test Results\nSheet]
        AX --> BC[Audit &\nFindings Sheet]
        AX --> BD[Artifacts\nSheet]
    end

    subgraph REVIEW["🏛 8. MANAGEMENT REVIEW"]
        BE[Auto-collect\nReview Inputs] --> BF[Present to\nISMS Committee]
        BF --> BG[Record Decisions\n& Action Items]
        BG --> BH[Set Next\nReview Date]
        BH --> BI([Continue\nISMS Cycle])
    end

    INIT --> DRATA
    DRATA --> RISK
    RISK --> TESTING
    TESTING --> AUDIT
    AUDIT --> ARTIFACT
    ARTIFACT --> REPORT
    REPORT --> REVIEW
    REVIEW -->|Continuous\nImprovement| DRATA

    style INIT fill:#1B3A6B,color:#fff,stroke:#fff
    style DRATA fill:#117A65,color:#fff,stroke:#fff
    style RISK fill:#E74C3C,color:#fff,stroke:#fff
    style TESTING fill:#2E6DA4,color:#fff,stroke:#fff
    style AUDIT fill:#6C3483,color:#fff,stroke:#fff
    style ARTIFACT fill:#F39C12,color:#fff,stroke:#fff
    style REPORT fill:#27AE60,color:#fff,stroke:#fff
    style REVIEW fill:#1B3A6B,color:#fff,stroke:#fff


---


%% ────────────────────────────────────────────────────────────
%% DIAGRAM 2: DRATA INTEGRATION DATA FLOW
%% ────────────────────────────────────────────────────────────

flowchart LR
    subgraph DRATA_PLATFORM["☁ Drata GRC Platform"]
        D1[Controls /\nRequirements]
        D2[Automated\nMonitors]
        D3[Evidence\nVault]
        D4[Risk Register]
        D5[Compliance\nScore]
    end

    subgraph API["🔌 Drata REST API\npublic-api.us.drata.com"]
        API1[GET /controls]
        API2[GET /monitors]
        API3[GET /evidence]
        API4[POST /risks]
        API5[GET /compliance/summary]
    end

    subgraph LOCAL["💻 Local GRC Automation"]
        L1[(SQLite DB)]
        L2[Control\nRegister]
        L3[Test\nResults]
        L4[Artifact\nStore]
        L5[Audit\nFindings]
        L6[Excel\nReport]
    end

    D1 -->|Nightly| API1 --> L2
    D2 -->|Nightly| API2 --> L3
    D3 -->|On-demand| API3 --> L4
    L5 -->|On finding| API4 --> D4
    D5 -->|On-demand| API5 --> L6

    L2 & L3 & L4 & L5 --> L1
    L1 --> L6

    style DRATA_PLATFORM fill:#117A65,color:#fff
    style API fill:#2E6DA4,color:#fff
    style LOCAL fill:#1B3A6B,color:#fff


---


%% ────────────────────────────────────────────────────────────
%% DIAGRAM 3: CONTROL TESTING WORKFLOW
%% ────────────────────────────────────────────────────────────

sequenceDiagram
    actor GRC_Team as GRC Team
    participant DB as Local GRC DB
    participant Drata as Drata Platform
    participant Auditor as Internal Auditor
    participant Owner as Control Owner

    GRC_Team->>DB: Pull control list (93 Annex A)
    DB-->>GRC_Team: Return controls + current statuses

    GRC_Team->>Drata: Sync monitor results (GET /monitors)
    Drata-->>DB: Return automated test results
    DB-->>GRC_Team: Flag failing monitors

    loop For each control requiring testing
        GRC_Team->>Owner: Request evidence / artifacts
        Owner-->>GRC_Team: Provide evidence
        GRC_Team->>DB: Register artifact (register_artifact)
        GRC_Team->>Auditor: Submit for review
        Auditor->>DB: Record test result (record_control_test)
        DB-->>GRC_Team: Update control status
    end

    alt Test FAILS
        Auditor->>DB: Create audit finding (add_audit_finding)
        DB->>Drata: Push finding as risk (POST /risks)
        Drata-->>Owner: Notify via Drata workflow
        Owner->>DB: Submit closure evidence
        Auditor->>DB: Close finding (close_finding)
    else Test PASSES
        DB-->>GRC_Team: Mark control Implemented
    end

    GRC_Team->>DB: Generate report (generate_report)
    DB-->>GRC_Team: ISO 27001 GRC Excel Workbook


---


